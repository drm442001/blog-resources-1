<!-- Prompt Library Engine v2.0 FINAL - Thumbnail Feature Complete -->
<!-- Sections: 10 | Presets: 4 | Validators: 6 | Export: Full Parity -->
<!-- Update Date: 2026-08-14 -->
<!-- ===== v2.2 UPDATE (2026-08-25) ===== -->
<!-- CHANGE 1: Added "🎯 Copy Prompt + Negative" button + copyPromptNegativeOnly() in Section 6 -->
<!-- CHANGE 2: Full Body output → Introduction → PROMPT: → NEGATIVE PROMPT: → COMPATIBLE AI TOOLS: → HOW TO USE THIS PROMPT: → EXPECTED OUTPUT: → TIPS & VARIATIONS: -->
<!-- CHANGE 3: Parser recognizes new template headings "2 · INTRODUCTION", "8 · COMPATIBLE AI TOOLS", expanded "9 · HOW TO USE THIS PROMPT" (How to Use / Expected Output / Tips & Variations) -->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Prompt Library Engine — Universal Blogger Prompt Library Template</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
       background:#0f1220;color:#e8eaf2;line-height:1.55;padding:22px 14px 90px}
  .wrap{max-width:960px;margin:0 auto}
  header{text-align:center;margin-bottom:18px}
  header h1{font-size:25px;font-weight:800;background:linear-gradient(90deg,#7c9cff,#c084fc);-webkit-background-clip:text;background-clip:text;color:transparent}
  header p{color:#9aa3b8;font-size:13px;margin-top:6px}

  /* ---------- Uploader ---------- */
  .uploader{background:#151932;border:1px solid #262c48;border-radius:16px;padding:18px;margin-bottom:18px}
  .dropzone{border:2px dashed #3a4470;border-radius:14px;padding:26px 16px;text-align:center;cursor:pointer;transition:.2s}
  .dropzone:hover,.dropzone.drag{border-color:#7c9cff;background:#12172f}
  .dropzone .big{font-size:34px}
  .dropzone .t{font-size:15px;font-weight:600;margin-top:6px}
  .dropzone .s{font-size:12.5px;color:#9aa3b8;margin-top:4px}
  .row{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px;align-items:center;justify-content:center}
  .btn{background:#232a4d;color:#cdd5f5;border:1px solid #35406e;border-radius:9px;padding:9px 15px;
       font-size:13px;font-weight:600;cursor:pointer;transition:.15s}
  .btn:hover{background:#2e3763;border-color:#4a58a0}
  .btn-main{background:linear-gradient(135deg,#7c9cff,#c084fc);color:#0f1220;border:none}
  .btn-main:hover{filter:brightness(1.08)}
  .btn-red{background:#c41d00;border-color:#a01700;color:#fff}
  .btn-red:hover{background:#a01700}
  details.paste{margin-top:12px}
  details.paste summary{cursor:pointer;font-size:13px;color:#8fa0d8;font-weight:600;user-select:none}
  details.paste textarea{width:100%;height:150px;margin-top:8px;border-radius:10px;border:1px solid #2a2f45;
       background:#101427;color:#e8eaf2;font-family:ui-monospace,monospace;font-size:12.5px;padding:10px;resize:vertical}

  /* ---------- Notices ---------- */
  .notice{margin-top:12px;padding:10px 13px;border-radius:10px;font-size:13px;display:none}
  .notice.warn{background:#3a2a10;border:1px solid #7a5a20;color:#ffcf87;display:block}
  .notice.err{background:#3a1414;border:1px solid #7a2020;color:#ff9b9b;display:block}
  .notice ul{margin:6px 0 0 18px}

  /* ---------- Tabs ---------- */
  .tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
  .tab{background:#171b2e;border:1px solid #2a2f45;border-radius:20px;padding:7px 15px;font-size:13px;
       font-weight:600;cursor:pointer;color:#cdd5f5;transition:.15s;display:flex;align-items:center;gap:7px}
  .tab:hover{border-color:#4a58a0}
  .tab.active{background:linear-gradient(135deg,#7c9cff,#c084fc);color:#0f1220;border:none}
  .tab .x{opacity:.6;font-weight:800}
  .tab .x:hover{opacity:1}
  .tab .cnt{font-size:11px;background:rgba(0,0,0,.18);padding:1px 7px;border-radius:10px}

  /* ---------- Toolbar for active category ---------- */
  .cat-bar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px}
  .cat-title{font-size:19px;font-weight:800}
  .cat-actions{display:flex;gap:8px;flex-wrap:wrap}

  .searchbar{position:sticky;top:0;z-index:20;background:#0f1220;padding:10px 0;margin-bottom:12px}
  .searchbar input{width:100%;padding:12px 16px;border-radius:12px;border:1px solid #2a2f45;
       background:#171b2e;color:#e8eaf2;font-size:15px;outline:none}
  .searchbar input:focus{border-color:#7c9cff}
  .count{font-size:12px;color:#9aa3b8;margin-top:6px;text-align:right}

  /* ---------- Cards ---------- */
  .card{background:#151932;border:1px solid #262c48;border-radius:16px;padding:18px;margin-bottom:20px;
        box-shadow:0 6px 24px rgba(0,0,0,.25)}
  .card-head{display:flex;align-items:center;gap:12px;margin-bottom:14px;flex-wrap:wrap}
  .num{background:linear-gradient(135deg,#7c9cff,#c084fc);color:#0f1220;font-weight:800;font-size:14px;
       padding:4px 11px;border-radius:20px}
  .ptitle{font-size:18px;font-weight:700;flex:1;min-width:180px}
  .sec{background:#101427;border:1px solid #242a44;border-radius:11px;padding:11px 13px;margin-bottom:11px}
  .sec-body{border-color:#3a4470;background:#12172f}
  /* Before Image Prompt card — full red highlight */
  .bip-card{background:#ff2400;border-color:#ff2400}
  .bip-card .lab{color:#fff}
  .bip-card .val{color:#fff}
  .bip-card .cbtn{background:#c41d00;border-color:#a01700;color:#fff}
  .bip-card .cbtn:hover{background:#a01700;border-color:#801200}
  .bip-card .cbtn.copied{background:#1e7d54;border-color:#25a06c;color:#fff}
  .sec-top{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:7px;flex-wrap:wrap}
  .lab{font-size:12px;font-weight:700;color:#8fa0d8;letter-spacing:.3px;text-transform:uppercase}
  .lab em{font-weight:500;text-transform:none;color:#9aa3b8}
  .cbtn{background:#232a4d;color:#cdd5f5;border:1px solid #35406e;border-radius:9px;
        padding:7px 12px;font-size:12.5px;font-weight:600;cursor:pointer;white-space:nowrap;transition:.15s}
  .cbtn:hover{background:#2e3763;border-color:#4a58a0}
  .cbtn.copied{background:#1e7d54;border-color:#25a06c;color:#fff}
  .cbtn-main{background:linear-gradient(135deg,#7c9cff,#c084fc);color:#0f1220;border:none}
  .cbtn-main:hover{filter:brightness(1.08)}
  .cbtn-main.copied{background:#1e7d54;color:#fff}
  .val{font-size:13.5px;color:#d3d9ee;white-space:pre-wrap;word-break:break-word}
  .val.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;color:#9fe6c1;font-size:13px}
  .body-block .mini-lab{font-size:11.5px;font-weight:800;color:#c084fc;text-transform:uppercase;margin:9px 0 3px}
  .body-block .mini-lab:first-child{margin-top:0}
  /* Thumbnail Alt length warning (SEO max 125 chars) */
  .alt-warn{color:#ff6b35;font-size:12px;background:#fff3ec;border-left:3px solid #ff6b35;
       padding:4px 8px;margin-top:4px;border-radius:4px}
  /* Section 10 style-preset dropdown */
  .preset-row{display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap}
  .preset-row label{font-size:12px;font-weight:700;color:#8fa0d8;letter-spacing:.3px;text-transform:uppercase}
  .stylePreset{background:#232a4d;color:#cdd5f5;border:1px solid #35406e;border-radius:9px;
       padding:7px 12px;font-size:12.5px;font-weight:600;cursor:pointer;outline:none;transition:.15s}
  .stylePreset:hover,.stylePreset:focus{background:#2e3763;border-color:#4a58a0}
  .howto{margin:2px 0 0 18px;font-size:13px;color:#d3d9ee}
  .howto li{margin-bottom:3px}
  .no-result{text-align:center;color:#9aa3b8;padding:40px;display:none}
  .empty{text-align:center;color:#6c7492;padding:50px 20px}
  footer{text-align:center;color:#6c7492;font-size:12px;margin-top:30px}
  .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(20px);
         background:#1e7d54;color:#fff;padding:11px 22px;border-radius:30px;font-size:14px;font-weight:600;
         opacity:0;pointer-events:none;transition:.25s;z-index:99}
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>Prompt Library Engine</h1>
    <p>Upload any prompt-library <b>.md</b> file → copy-ready Blogger cards. Includes upgraded universal template logic for category labels, SEO sequence and (2026) titles.</p>
  </header>

  <!-- UPLOADER -->
  <div class="uploader">
    <div class="dropzone" id="dropzone">
      <div class="big">📤</div>
      <div class="t">Drag &amp; drop your .md file here</div>
      <div class="s">or click to browse — you can add multiple category files</div>
    </div>
    <input type="file" id="fileInput" accept=".md,.markdown,.txt" multiple style="display:none">
    <div class="row">
      <button class="btn btn-main" id="browseBtn">📁 Choose .md file(s)</button>
      <button class="btn" id="templateBtn">📄 Download upgraded master template</button>
      <button class="btn btn-red" id="clearBtn">🗑 Clear all</button>
    </div>
    <details class="paste">
      <summary>📋 …or paste .md content directly (best for sandbox/preview)</summary>
      <textarea id="pasteArea" placeholder="Paste the full .md content here, then click the button below…"></textarea>
      <div class="row" style="justify-content:flex-start">
        <input class="btn" id="pasteName" placeholder="Category name (optional)" style="background:#101427;color:#e8eaf2">
        <button class="btn btn-main" id="pasteBtn">➕ Load pasted content</button>
      </div>
    </details>
    <div class="notice" id="notice"></div>
  </div>

  <!-- TABS -->
  <div class="tabs" id="tabs"></div>

  <!-- ACTIVE CATEGORY -->
  <div id="catArea">
    <div class="empty" id="emptyState">
      <div style="font-size:40px">🗂️</div>
      <p style="margin-top:8px">No library loaded yet. Upload or paste a <b>.md</b> file to begin.</p>
    </div>
  </div>

  <footer>Prompt Library Engine · one engine for all your categories · buttons copy exactly the highlighted section.</footer>
</div>

<div class="toast" id="toast">✓ Copied!</div>

<script>
(function(){
"use strict";

/* =====================================================
   STATE
===================================================== */
var libraries=[];      // [{name, prompts:[...]}]
var activeIdx=-1;
var lastCopiedBtn=null;
var srcStore={};       // id -> raw text to copy
var promptStore={};    // id -> prompt object (for Section 10 preset rebuild)
var uid=0;

/* =====================================================
   HELPERS
===================================================== */
function el(id){return document.getElementById(id);}
function esc(s){return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}

var toast=el('toast'),toastT;
function showToast(msg){toast.textContent=msg;toast.classList.add('show');
  clearTimeout(toastT);toastT=setTimeout(function(){toast.classList.remove('show');},1400);}

function resetBtn(b){
  if(!b)return;
  if(b.getAttribute('data-orig')!==null){b.textContent=b.getAttribute('data-orig');}
  b.classList.remove('copied');
}
function doCopy(text,btn){
  if(btn.getAttribute('data-orig')===null){btn.setAttribute('data-orig',btn.textContent);}
  function ok(){
    if(lastCopiedBtn&&lastCopiedBtn!==btn){resetBtn(lastCopiedBtn);}
    btn.classList.add('copied');btn.textContent='✓ Copied';
    lastCopiedBtn=btn;showToast('✓ Copied!');
  }
  if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(text).then(ok).catch(function(){fallback(text,ok);});
  }else{fallback(text,ok);}
}
function fallback(text,ok){
  var ta=document.createElement('textarea');ta.value=text;ta.style.position='fixed';ta.style.left='-9999px';
  document.body.appendChild(ta);ta.select();
  try{document.execCommand('copy');ok();}catch(e){alert('Copy failed — select manually.');}
  document.body.removeChild(ta);
}

/* =====================================================
   CHANGE 1 — SECTION 6: COPY PROMPT + NEGATIVE ONLY
   Exposed on window because the engine runs inside an IIFE
   and the 🎯 button calls it via inline onclick.
   ACTUAL selectors used (see cardHTML Section 6 .body-block):
     prompt text   → <div class="val" data-field="prompt">
     negative text → <div class="val" data-field="negative">
   Scoped to the clicked card (btn.closest('.card')) so pages
   with many prompt cards always copy the right one.
===================================================== */
window.copyPromptNegativeOnly=function copyPromptNegativeOnly(btn){
  btn=btn||((window.event&&window.event.target)?window.event.target:null);
  var scope=(btn&&btn.closest)?(btn.closest('.card')||document):document;
  // Get prompt text — engine's actual element: .body-block div.val[data-field="prompt"]
  var promptEl=scope.querySelector('[data-field="prompt"], .prompt-text, #prompt-output');
  // Get negative prompt text — engine's actual element: .body-block div.val[data-field="negative"]
  var negativeEl=scope.querySelector('[data-field="negative"], .negative-text, #negative-output');

  var promptText=promptEl?promptEl.innerText.trim():'';
  var negativeText=negativeEl?negativeEl.innerText.trim():'';

  var combined='';
  if(promptText)combined+=promptText;
  if(negativeText)combined+='\n\nNEGATIVE PROMPT:\n'+negativeText;

  if(!combined.trim()){
    alert('No prompt text found!');
    return;
  }

  function showSuccess(){
    if(btn){
      // Show success feedback
      var original=btn.getAttribute('data-orig-label');
      if(original===null){original=btn.innerHTML;btn.setAttribute('data-orig-label',original);}
      btn.innerHTML='✅ Copied!';
      btn.style.background='#059669';
      setTimeout(function(){
        btn.innerHTML=original;
        btn.style.background='';
      },2000);
    }
    showToast('✓ Prompt + Negative copied!');
  }

  if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(combined)
      .then(showSuccess)
      .catch(function(){fallback(combined,showSuccess);}); // engine's existing textarea fallback
  }else{
    fallback(combined,showSuccess); // textarea + execCommand fallback
  }
};

/* =====================================================
   MARKDOWN PARSER
   Understands the prompt-library section format.
===================================================== */
function stripBullets(t){
  return (t||'').split('\n').map(function(l){
    return l.replace(/^\s*[-*]\s+/,'').replace(/\*\*/g,'').trim();
  }).filter(function(l){return l.length;}).join('\n');
}
function cleanInline(t){return (t||'').replace(/\*\*/g,'').replace(/`/g,'').trim();}

// Field aliases (case-insensitive) mapped to canonical keys
var FIELD_MAP=[
  {k:'title',   re:/^(\d+\s*[·.\-–—)]*\s*)?prompt\s*title/i},
  /* ---- v3.0 FIX 1: POST TITLE aliases (added only, existing alias untouched) ---- */
  {k:'title',   re:/\b1\s*[·.]\s*POST\s*TITLE\b/i},       // "**1 · POST TITLE**" / "**1. POST TITLE**"
  {k:'title',   re:/\bPOST\s+TITLE\b/i},                  // "**POST TITLE**"
  {k:'before',  re:/before\s*image\s*prompt/i},
  /* ---- v3.0 FIX 2: NEW field altThumb (template Section 4) — CASE B ---- */
  {k:'altThumb',re:/\b4\s*[·.]\s*ALT\s*TEXT.*THUMBNAIL/i}, // "**4 · ALT TEXT — THUMBNAIL IMAGE**"
  {k:'altThumb',re:/ALT\s*TEXT.*THUMBNAIL(\s*IMAGE)?/i},
  {k:'altThumb',re:/\bALT.*THUMB/i},
  /* ---- v3.0 FIX 3: Section 5 combined alt block — entry-point alias (CASE A);
         inline "Before Image Alt:" / "After Image Alt:" sub-lines are mapped in the parse loop ---- */
  {k:'altpair', re:/\b5\s*[·.]\s*ALT\s*TEXT.*BEFORE/i},    // "**5 · ALT TEXT — BEFORE / AFTER IMAGES**"
  {k:'altpair', re:/ALT\s*TEXT.*BEFORE.*AFTER/i},
  {k:'altAfter',re:/after\s*image.*alt\s*text/i},
  {k:'altBefore',re:/before\s*image.*alt\s*text/i},
  {k:'negative',re:/negative\s*prompt/i},        // check before generic "prompt"
  {k:'howto',   re:/how\s*to\s*use\s*this\s*prompt/i},
  /* ---- CHANGE 3 (v2.2 template): new + expanded section headings ---- */
  {k:'intro',   re:/introduction/i},                                  // NEW 2 · INTRODUCTION
  {k:'tools',   re:/compatible\s+ai\s+tools/i},                       // NEW 8 · COMPATIBLE AI TOOLS
  {k:'tools',   re:/recommended\s+ai\s+tools/i},                      // legacy alias: v2.1 "### 🤖 Recommended AI Tools"
  {k:'expected',re:/^(\d+\s*[·.\-–—)]*\s*)?expected\s+(output|result)/i}, // NEW 9 sub-heading: Expected Output
  {k:'tips',    re:/tips?\s*(&|and)\s*variations?/i},                 // NEW 9 sub-heading: Tips & Variations
  {k:'howto',   re:/^(\d+\s*[·.\-–—)]*\s*)?how\s*to\s*use\b/i},       // NEW 9 sub-heading: How to Use
  /* ----------------------------------------------------------------- */
  {k:'labels',  re:/labels/i},
  {k:'permalink',re:/permalink/i},
  {k:'search',  re:/search\s*description/i},
  /* ---- v3.0 FIX 4: NEW field thumb (template Section 10) — CASE B; checked before generic "prompt" ---- */
  {k:'thumb',   re:/\b10\s*[·.]\s*THUMBNAIL.*PROMPT/i},   // "**10 · THUMBNAIL IMAGE GENERATOR PROMPT**"
  {k:'thumb',   re:/THUMBNAIL.*GENERATOR.*PROMPT/i},
  {k:'thumb',   re:/THUMBNAIL.*IMAGE.*GENERATOR/i},
  {k:'prompt',  re:/^(\d+\s*[·.\-–—)]*\s*)?prompt\b/i} // generic prompt last (tolerates numbered "6 · PROMPT" headings)
];

function classifyHeading(h){
  var s=h.replace(/[:*`]/g,'').trim();
  for(var i=0;i<FIELD_MAP.length;i++){ if(FIELD_MAP[i].re.test(s)) return FIELD_MAP[i].k; }
  return null;
}

function parseMarkdown(md){
  var lines=md.replace(/\r/g,'').split('\n');
  // Category name from first # heading
  var catName='Prompt Library';
  for(var i=0;i<lines.length;i++){
    var mh=lines[i].match(/^#\s+(.*)/);
    if(mh){catName=cleanInline(mh[1]);break;}
  }
  // Split into prompt blocks by "## Prompt #N" (or any "## " that isn't the title)
  var prompts=[];
  var blockRe=/^##\s+Prompt\s*#?\s*(\d+)/i;
  var idxs=[];
  for(var j=0;j<lines.length;j++){ if(blockRe.test(lines[j])) idxs.push(j); }
  if(!idxs.length) return {name:catName,prompts:[],error:'No "## Prompt #N" blocks found.'};

  for(var b=0;b<idxs.length;b++){
    var start=idxs[b];
    var end=(b+1<idxs.length)?idxs[b+1]:lines.length;
    var num=(lines[start].match(blockRe)||[])[1]||String(b+1);
    var body=lines.slice(start+1,end);
    var fields={};
    var curKey=null,buf=[];
    function flush(){ if(curKey){fields[curKey]=(fields[curKey]?fields[curKey]+'\n':'')+buf.join('\n').trim();} buf=[]; }
    for(var r=0;r<body.length;r++){
      var line=body[r];
      // v3.0 FIX 5: skip pure divider lines (━━━ / === / --- separators) BEFORE any heading detection —
      // only lines made ENTIRELY of separator chars are skipped; text+separator lines are kept.
      if(/^[━=\-]{3,}\s*$/.test(line.trim())) continue;
      if(/^---\s*$/.test(line)) continue;
      // "## Frequently Asked Questions" always belongs to the How To Use body (legacy behaviour)
      if(/^\s*##\s+(frequently asked questions|faq)/i.test(line)){ flush(); curKey='howto'; buf.push(line); continue; }
      // v3.0 FIX 3: Section 5 inline sub-lines — map directly onto the existing altBefore/altAfter fields
      var mAltB=line.match(/^\s*Before\s+Image\s+Alt\s*:\s*(.*)$/i);
      if(mAltB){ flush(); curKey='altBefore'; if(mAltB[1].trim())buf.push(mAltB[1].trim()); continue; }
      var mAltA=line.match(/^\s*After\s+Image\s+Alt\s*:\s*(.*)$/i);
      if(mAltA){ flush(); curKey='altAfter'; if(mAltA[1].trim())buf.push(mAltA[1].trim()); continue; }
      // A heading line looks like **Something** possibly with trailing colon, OR "### ..." markers
      var head=null;
      var m1=line.match(/^\s*\*\*(.+?)\*\*\s*:?\s*$/);      // **Prompt Title:**  or **Prompt**
      var m2=line.match(/^\s*#{3,}\s*(.+?)\s*$/);            // ### heading (skip settings dividers)
      if(m1){head=m1[1];}
      if(head!==null){
        var key=classifyHeading(head);
        if(key){ flush(); curKey=key; continue; }
        // unknown bold heading -> treat as normal text under current key
      }
      if(m2){ // ### sub-heading — CHANGE 3: recognize known sub-headings (e.g. "### Expected Output", "### 🤖 Recommended AI Tools")
        var subKey=classifyHeading(m2[1]);
        if(subKey){ flush(); curKey=subKey; }
        else if(curKey==='tools'||curKey==='expected'||curKey==='tips'){ flush(); curKey='howto'; } // unknown sub-block (e.g. "### ⚠️ Common Mistakes") returns to parent How To Use
        continue; // unknown ### divider (e.g. "### BLOGGER SETTINGS") -> skip line, unchanged legacy behaviour
      }
      buf.push(line);
    }
    flush();
    prompts.push({
      num:num,
      title:cleanInline(fields.title||''),
      intro:cleanInline(fields.intro||''),        // CHANGE 3 — template 2 · INTRODUCTION
      before:cleanInline(fields.before||''),
      altThumb:cleanInline(fields.altThumb||''),  // v3.0 FIX 2 — template 4 · ALT TEXT — THUMBNAIL IMAGE
      altAfter:cleanInline(fields.altAfter||''),
      altBefore:cleanInline(fields.altBefore||''),
      prompt:cleanInline(fields.prompt||''),
      negative:cleanInline(fields.negative||''),
      tools:stripBullets(fields.tools||''),       // CHANGE 3 — template 8 · COMPATIBLE AI TOOLS
      howto:stripBullets(fields.howto||''),
      expected:stripBullets(fields.expected||''), // CHANGE 3 — template 9 sub: Expected Output
      tips:stripBullets(fields.tips||''),         // CHANGE 3 — template 9 sub: Tips & Variations
      thumb:cleanInline(fields.thumb||''),        // v3.0 FIX 4 — template 10 · THUMBNAIL IMAGE GENERATOR PROMPT
      labels:cleanInline(fields.labels||''),
      permalink:cleanInline((fields.permalink||'').replace(/`/g,'')),
      search:cleanInline(fields.search||'')
    });
  }
  return {name:catName,prompts:prompts};
}

/* =====================================================
   FORMAT CHECKER
===================================================== */
function checkLibrary(lib){
  var problems=[];
